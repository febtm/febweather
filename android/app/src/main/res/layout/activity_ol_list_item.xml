<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@color/colorPrimaryTransparent77"
    android:layout_margin="5dp">

    <TextView
        android:id="@+id/ol_li_icon"
        android:layout_width="40dp"
        android:layout_height="wrap_content"
        android:textColor="@color/colorSecondary"
        android:gravity="center"
        android:layout_gravity="start|center_vertical"
        android:textStyle="bold"
        android:textSize="32sp"
        android:layout_marginStart="5dp"
        android:layout_marginLeft="5dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:layout_marginStart="10dp"
        android:layout_marginLeft="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="35dp"
        android:layout_marginRight="35dp">

        <TextView
            android:id="@+id/ol_li_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/colorSecondary" />

        <TextView
            android:id="@+id/ol_li_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:layout_marginTop="5dp"
            android:textStyle="bold|italic"
            android:textColor="@color/colorSecondary" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:layout_marginEnd="10dp"
            android:layout_marginRight="10dp"
            android:background="@drawable/app_temperature"/>

        <TextView
            android:id="@+id/ol_li_temperature"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:layout_marginEnd="20dp"
            android:layout_marginRight="20dp"
            android:textStyle="bold|italic"
            android:textColor="@color/colorSecondary" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:layout_marginEnd="10dp"
            android:layout_marginRight="10dp"
            android:background="@drawable/app_humidity"/>

        <TextView
            android:id="@+id/ol_li_humidity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textStyle="bold|italic"
            android:textColor="@color/colorSecondary" />

    </LinearLayout>

    </LinearLayout>

    <ImageButton
        android:id="@+id/ol_li_delete_location"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="5dp"
        android:layout_marginRight="5dp"
        android:layout_gravity="center_vertical|end"
        android:contentDescription="@null"
        android:background="@drawable/app_delete"/>

    </FrameLayout>

</LinearLayout>